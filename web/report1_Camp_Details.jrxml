	<queryString language="SQL">
		<![CDATA[SELECT
     camp_details.`Camp_id` AS camp_details_Camp_id,
     camp_details.`Camp_name` AS camp_details_Camp_name,
     camp_details.`Organizer_name` AS camp_details_Organizer_name,
     camp_details.`Address` AS camp_details_Address,
     camp_details.`Date` AS camp_details_Date,
     camp_details.`Start_time` AS camp_details_Start_time,
     camp_details.`End_time` AS camp_details_End_time,
     camp_details.`Email` AS camp_details_Email,
     camp_details.`Contact_no` AS camp_details_Contact_no
FROM
     `camp_details` camp_details]]>
	</queryString>
