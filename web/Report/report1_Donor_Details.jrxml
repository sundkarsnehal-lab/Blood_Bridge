	<queryString language="SQL">
		<![CDATA[SELECT
     donor_details.`Donor_id` AS donor_details_Donor_id,
     donor_details.`Name` AS donor_details_Name,
     donor_details.`Age` AS donor_details_Age,
     donor_details.`Weight` AS donor_details_Weight,
     donor_details.`Gender` AS donor_details_Gender,
     donor_details.`Blood_Group` AS donor_details_Blood_Group,
     donor_details.`Blood_Type` AS donor_details_Blood_Type,
     donor_details.`Contact_no` AS donor_details_Contact_no,
     donor_details.`Donation_Date` AS donor_details_Donation_Date,
     donor_details.`Address` AS donor_details_Address,
     donor_details.`Quantity` AS donor_details_Quantity
FROM
     `donor_details` donor_details]]>
	</queryString>
